// Prompters data model.
// Content is edited in working tables (Topic, TopicSection, Visualization) and
// snapshotted into TopicVersion on publish. Students always read the latest
// TopicVersion, so drafts never leak and history stays tied to the version studied.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Users ─────────────────────────

enum Role {
  STUDENT
  AUTHOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum StartLanguage {
  PYTHON
  JAVASCRIPT
}

enum ExplanationLocale {
  hinglish
  en
  hi
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  googleId     String?    @unique
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  /// Bumped on logout-all / password change / suspension to invalidate tokens.
  tokenVersion Int        @default(0)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile            UserProfile?
  masteries          Mastery[]
  quizAttempts       QuizAttempt[]
  submissions        Submission[]
  projectSubmissions ProjectSubmission[]
  readiness          ReadinessSnapshot[]
  events             LearningEvent[]
  applications       Application[]
  stageProgress      StageProgress[]
  promptFavorites    PromptFavorite[]
  promptRatings      PromptRating[]
  interviewPractice  InterviewPractice[]
  achievements       Achievement[]
  auditLogs          AdminAuditLog[]
  resumes            CareerResume[]
  targetRoles        TargetRoleProfile[]
  jobTargets         JobTarget[]
  jobMatches         JobMatch[]
  interviewSessions  InterviewSession[]
  prepPlans          PrepPlan[]
  prepAttempts       PrepAttempt[]
  prepPacks          PrepPack[]
  conceptProgress    ConceptProgress[]
  skillStates        StudentSkillState[]
  recommendations    Recommendation[]
  recFeedback        RecommendationFeedback[]
  mlPredictions      MLPrediction[]
  projectExperiences ProjectExperience[]
  projectTests       ProjectTest[]
  projectAnswers     ProjectAnswer[]

  @@index([role])
  @@index([createdAt])
}

model UserProfile {
  userId               String            @id
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl            String?
  education            String?
  year                 Int?
  codingLevel          String?
  startLanguage        StartLanguage?
  explanationLocale    ExplanationLocale @default(hinglish)
  goalRole             String?
  targetCompanies      String[]          @default([])
  targetSalary         String?
  targetDate           DateTime?
  weeklyHours          Int?
  skills               String[]          @default([])
  goals                String?
  headline             String?
  summary              String?
  links                Json?
  onboardedAt          DateTime?
  placementCompletedAt DateTime?
  updatedAt            DateTime          @updatedAt
}

// ───────────────────────── Curriculum ─────────────────────────

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  COMING_SOON
  ARCHIVED
}

enum StageTrack {
  COMMON
  PYTHON
  JAVASCRIPT
}

model Stage {
  id          String        @id @default(cuid())
  slug        String        @unique
  code        String
  title       String
  description String
  track       StageTrack    @default(COMMON)
  order       Int
  estHours    Int           @default(0)
  targetRoles String[]      @default([])
  icon        String?
  color       String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules     Module[]
  progress    StageProgress[]
  assessments Assessment[]

  @@index([order])
}

model Module {
  id          String        @id @default(cuid())
  stageId     String
  stage       Stage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  slug        String        @unique
  title       String
  description String
  order       Int
  difficulty  Int           @default(1)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  topics Topic[]

  @@index([stageId, order])
}

model Topic {
  id                  String        @id @default(cuid())
  moduleId            String
  module              Module        @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  slug                String        @unique
  title               String
  order               Int
  difficulty          Int           @default(1)
  estMinutes          Int           @default(15)
  objectives          String[]      @default([])
  technicalDefinition String?
  tags                String[]      @default([])
  status              ContentStatus @default(DRAFT)
  /// Number of the latest published TopicVersion (0 = never published).
  publishedVersion    Int           @default(0)
  quizSize            Int           @default(5)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sections      TopicSection[]
  visualization Visualization?
  versions      TopicVersion[]
  prerequisites TopicPrerequisite[] @relation("TopicPrereqs")
  requiredBy    TopicPrerequisite[] @relation("PrereqOf")
  questions     Question[]
  buildTasks    BuildTask[]
  promptCards   PromptCard[]
  interviewQs   InterviewQuestion[]
  masteries     Mastery[]
  quizAttempts  QuizAttempt[]

  @@index([moduleId, order])
  @@index([status])
}

model TopicPrerequisite {
  topicId        String
  topic          Topic  @relation("TopicPrereqs", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Topic  @relation("PrereqOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
}

model TopicSection {
  id         String  @id @default(cuid())
  topicId    String
  topic      Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type       String
  order      Int
  /// { hinglish, en, hi? } — localisation lives in data, never in UI code.
  content    Json
  codeJs     String?
  codePython String?

  @@unique([topicId, type])
}

model Visualization {
  id      String @id @default(cuid())
  topicId String @unique
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind    String
  title   String
  /// [{ title, description, highlight?, durationMs? }]
  steps   Json
}

model TopicVersion {
  id            String   @id @default(cuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  version       Int
  /// Full topic snapshot (meta, sections, visualization) as students see it.
  snapshot      Json
  publishedById String?
  note          String?
  createdAt     DateTime @default(now())

  @@unique([topicId, version])
}

// ───────────────────────── Assessment ─────────────────────────

enum QuestionType {
  MCQ
  MULTI
  PREDICT_OUTPUT
  SPOT_BUG
  FILL_CODE
  SCENARIO
  ORDER_STEPS
  EXPLAIN
}

model Question {
  id           String        @id @default(cuid())
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type         QuestionType
  difficulty   Int           @default(1)
  prompt       String
  code         String?
  codeLanguage String?
  options      Json?
  /// Option indices; null for ORDER_STEPS (option order is the answer) and EXPLAIN.
  correct      Json?
  keywords     String[]      @default([])
  explanation  String
  tags         String[]      @default([])
  points       Int           @default(1)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([topicId, status])
}

enum AttemptKind {
  PLACEMENT
  MASTERY
  REVIEW
  PRACTICE
  STAGE_EXAM
  MOCK_TEST
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ViolationPolicy {
  LOG
  FLAG
  AUTO_SUBMIT
}

model Assessment {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  description       String?
  kind              AttemptKind
  stageId           String?
  stage             Stage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Topic slugs the question pool is drawn from (empty = whole stage).
  topicSlugs        String[]        @default([])
  durationMinutes   Int             @default(30)
  questionCount     Int             @default(20)
  passingScore      Int             @default(70)
  maxAttempts       Int?
  tabSwitchLimit    Int             @default(3)
  violationPolicy   ViolationPolicy @default(FLAG)
  blockClipboard    Boolean         @default(true)
  requireFullscreen Boolean         @default(true)
  status            ContentStatus   @default(PUBLISHED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  attempts QuizAttempt[]
}

model QuizAttempt {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId        String?
  topic          Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  assessmentId   String?
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  kind           AttemptKind
  status         AttemptStatus @default(IN_PROGRESS)
  topicVersion   Int?
  questionIds    String[]
  /// Per-question order of displayed option indices, so grading maps back correctly.
  optionOrders   Json
  /// Latest saved answers (autosave) — { [questionId]: answer }
  draftAnswers   Json?
  /// Graded result per question incl. a snapshot of the question as asked.
  results        Json?
  score          Float?
  passed         Boolean?
  flagged        Boolean       @default(false)
  integrityScore Int?
  startedAt      DateTime      @default(now())
  expiresAt      DateTime?
  finishedAt     DateTime?

  integrityEvents IntegrityEvent[]

  @@index([userId, kind, startedAt])
  @@index([userId, topicId])
}

model IntegrityEvent {
  id        String      @id @default(cuid())
  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([attemptId])
}

enum MasteryStatus {
  LEARNING
  MASTERED
  NEEDS_REVIEW
}

model Mastery {
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status         MasteryStatus @default(LEARNING)
  source         String?
  bestScore      Float         @default(0)
  lastScore      Float?
  attempts       Int           @default(0)
  readAt         DateTime?
  masteredAt     DateTime?
  reviewStep     Int           @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  /// Latest spaced-review score (0–100); drives the "recall" part of readiness.
  recallScore    Float?
  updatedAt      DateTime      @updatedAt

  @@id([userId, topicId])
  @@index([userId, nextReviewAt])
}

model StageProgress {
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId       String
  stage         Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  bestExamScore Float?
  passedAt      DateTime?
  passedBy      String?

  @@id([userId, stageId])
}

// ───────────────────────── Build without AI ─────────────────────────

model BuildTask {
  id               String        @id @default(cuid())
  slug             String        @unique
  topicId          String?
  topic            Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title            String
  description      String
  functionName     String
  starterJs        String
  starterPython    String
  /// [{ name, args, expected, hidden }]
  tests            Json
  /// [concept, step, partial code]
  hints            Json
  /// [{ question, keywords }]
  explainQuestions Json
  difficulty       Int           @default(1)
  estMinutes       Int           @default(20)
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  submissions Submission[]
}

enum SubmissionStatus {
  IN_PROGRESS
  TESTS_PASSED
  COMPLETED
}

model Submission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildTaskId       String
  buildTask         BuildTask        @relation(fields: [buildTaskId], references: [id], onDelete: Cascade)
  language          String
  code              String
  status            SubmissionStatus @default(IN_PROGRESS)
  hintsUsed         Int              @default(0)
  runs              Int              @default(0)
  submits           Int              @default(0)
  testResult        Json?
  passedCount       Int              @default(0)
  totalCount        Int              @default(0)
  explainAnswers    Json?
  explainScore      Float?
  independenceScore Float?
  projectScore      Float?
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  updatedAt         DateTime         @updatedAt

  @@unique([userId, buildTaskId])
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  rung             Int           @unique
  title            String
  description      String
  skills           String[]      @default([])
  technologies     String[]      @default([])
  /// ["requirement", ...]
  requirements     Json
  /// [{ title, description }]
  milestones       Json
  /// [{ question, keywords }]
  explainQuestions Json
  /// [concept, step, partial code]
  hints            Json          @default("[]")
  stageSlug        String?
  difficulty       Int           @default(1)
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl           String
  liveUrl           String?
  /// { approach, bugFixed, tradeoff }
  howIBuiltIt       Json
  explainAnswers    Json
  explainScore      Float
  milestonesDone    Int              @default(0)
  hintsUsed         Int              @default(0)
  independenceScore Float
  status            SubmissionStatus @default(COMPLETED)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([userId, projectId])
}

// ───────────────────────── Prompts & interviews ─────────────────────────

model PromptCard {
  id              String        @id @default(cuid())
  slug            String        @unique
  topicId         String
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title           String
  category        String
  task            String
  whenToUse       String
  template        String
  variables       Json
  whyItWorks      Json
  verifyChecklist Json
  sampleOutput    String
  version         Int           @default(1)
  status          ContentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  favorites PromptFavorite[]
  ratings   PromptRating[]

  @@index([topicId])
  @@index([category])
}

model PromptFavorite {
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId String
  prompt   PromptCard @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
}

model PromptRating {
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId String
  prompt   PromptCard @relation(fields: [promptId], references: [id], onDelete: Cascade)
  rating   Int

  @@id([userId, promptId])
}

model InterviewQuestion {
  id            String        @id @default(cuid())
  topicId       String?
  topic         Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  category      String
  question      String
  short         String
  deep          String
  followUps     String[]      @default([])
  commonMistake String
  keywords      String[]      @default([])
  difficulty    Int           @default(1)
  roles         String[]      @default([])
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  practice InterviewPractice[]

  @@index([category])
}

model InterviewPractice {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  score      Float
  matched    String[]          @default([])
  missing    String[]          @default([])
  createdAt  DateTime          @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── Journey & career ─────────────────────────

model ReadinessSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  breakdown    Json
  weakestAreas Json
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// The student event log (also the personalization "StudentEvent" store — no second events table).
model LearningEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  topicId    String?
  meta       Json?
  /// Normalized name for personalization: TOPIC_STARTED, QUIZ_COMPLETED, BUILD_FAILED…
  eventType  String?
  /// What the event is about (TOPIC, QUIZ_ATTEMPT, BUILD_TASK, PREP_QUESTION, INTERVIEW_SESSION…) and its id.
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([entityId])
}

model Achievement {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  earnedAt DateTime @default(now())

  @@id([userId, key])
}

model Application {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  status      String    @default("APPLIED")
  round       String?
  appliedAt   DateTime?
  nextStepAt  DateTime?
  interviewAt DateTime?
  result      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// ───────────────────────── Platform settings ─────────────────────────

model FeatureFlag {
  key            String   @id
  description    String
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  userIds        String[] @default([])
  updatedAt      DateTime @updatedAt
}

model ScoringConfig {
  id          String   @id @default(cuid())
  version     Int      @unique
  config      Json
  active      Boolean  @default(false)
  createdById String?
  note        String?
  createdAt   DateTime @default(now())
}

/// Editable public-website copy (e.g. key "landing"), managed by Super Admins. Defaults live in the
/// frontend; this row only stores overrides. `version` guards against two admins overwriting each other.
model SiteContent {
  key         String   @id
  content     Json
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Interview & Career Intelligence ─────────────────────────

model CareerResume {
  id         String              @id @default(cuid())
  projects   ProjectExperience[]
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  fileName   String?
  /// Original upload in object storage (deleted with the resume).
  storageKey String?
  text       String
  /// Structured extraction: skills, projects, experience, education, claims…
  parsed     Json
  createdAt  DateTime            @default(now())
  /// Set once semantic chunks + claims have been extracted (older resumes get them lazily).
  analyzedAt DateTime?
  matches    JobMatch[]
  chunks     ResumeChunk[]
  claims     ResumeClaim[]
  prepPlans  PrepPlan[]
  interviews InterviewSession[]

  @@index([userId, createdAt])
}

model JobTarget {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  company            String?
  text               String
  parsed             Json
  createdAt          DateTime            @default(now())
  matches            JobMatch[]
  prepPlans          PrepPlan[]
  targetRoleProfiles TargetRoleProfile[]

  @@index([userId, createdAt])
}

model JobMatch {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    CareerResume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobTarget          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Weighted from `breakdown` by code, not by the model.
  score     Int
  breakdown Json
  strong    String[]           @default([])
  missing   String[]           @default([])
  risks     Json
  claims    Json
  /// Prioritised, resume-grounded question bank.
  questions Json
  model     String?
  createdAt DateTime           @default(now())
  sessions  InterviewSession[]

  @@index([userId, createdAt])
}

enum InterviewStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ENDED_INTEGRITY
  ABANDONED
}

model InterviewSession {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when the interview is based on a job-description analysis; otherwise resume + target role.
  matchId             String?
  match               JobMatch?                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  resumeId            String?
  resume              CareerResume?             @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  targetRole          String?
  /// The career (target-role profile) this interview prepares for. Null for older sessions whose
  /// career can't be determined unambiguously. Its role always equals targetRole.
  targetRoleProfileId String?
  targetRoleProfile   TargetRoleProfile?        @relation(fields: [targetRoleProfileId], references: [id], onDelete: SetNull)
  /// STANDARD | HARD
  difficulty          String                    @default("STANDARD")
  /// Question bank for role-only interviews (match-based ones read the analysis bank).
  bank                Json?
  /// Planned share of the interview per area: [{ area, target }].
  blueprint           Json?
  /// Weak skills carried over from earlier interviews on the same resume.
  focusAreas          String[]                  @default([])
  pausedAt            DateTime?
  pausedMs            Int                       @default(0)
  /// AI calls made for this session (bounded to keep cost predictable).
  aiCalls             Int                       @default(0)
  status              InterviewStatus           @default(IN_PROGRESS)
  language            String                    @default("hinglish")
  durationMinutes     Int                       @default(30)
  questionTarget      Int                       @default(15)
  /// { recording, integrity, preparationOnly, at }
  consent             Json
  screenShareWarnings Int                       @default(0)
  readinessScore      Int?
  result              String?
  report              Json?
  startedAt           DateTime                  @default(now())
  endedAt             DateTime?
  turns               InterviewTurn[]
  integrityEvents     InterviewIntegrityEvent[]

  @@index([userId, startedAt])
  @@index([resumeId])
  @@index([userId, targetRoleProfileId, startedAt])
}

model InterviewTurn {
  id            String           @id @default(cuid())
  sessionId     String
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order         Int
  /// QUESTION | FOLLOW_UP | CODING
  kind          String
  parentId      String?
  /// Id of the question in JobMatch.questions (root questions only).
  bankId        String?
  question      String
  /// What Manisha says before the question ("Okay, thanks.").
  lead          String?
  skill         String
  category      String
  level         Int              @default(1)
  buildTaskSlug String?
  answerText    String?
  answerCode    String?
  codeLanguage  String?
  codeResult    Json?
  audioKey      String?
  audioMime     String?
  durationSec   Int?
  skipped       Boolean          @default(false)
  evaluation    Json?
  /// Blueprint area this question covers (RESUME, PROJECTS, FUNDAMENTALS, ROLE, PRACTICAL, PROBLEM_SOLVING, SYSTEM_DESIGN).
  area          String?
  /// Resume claim this question probes, when there is one.
  claimId       String?
  /// Set while an answer is being evaluated, so a duplicate submit can't double-process it.
  submittedAt   DateTime?
  /// Not scored (e.g. the transcript was unclear and the question was asked again).
  excluded      Boolean          @default(false)
  askedAt       DateTime         @default(now())
  answeredAt    DateTime?

  @@unique([sessionId, order])
  @@index([answeredAt])
}

model InterviewIntegrityEvent {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([sessionId])
}

// ───────────────────────── Resume intelligence & Top-100 preparation ─────────────────────────

enum ResumeChunkType {
  SUMMARY
  EXPERIENCE
  PROJECT
  SKILL
  ACHIEVEMENT
  EDUCATION
  CERTIFICATION
  OTHER
}

/// One semantic unit of a resume (a project, a job, a skill with its evidence…).
model ResumeChunk {
  id           String          @id @default(cuid())
  resumeId     String
  resume       CareerResume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  order        Int
  type         ResumeChunkType
  section      String
  title        String
  text         String
  technologies String[]        @default([])
  /// PROJECT: { problem, architecture, features[], contribution, complexity }; SKILL: { evidence[] }.
  meta         Json?
  /// HIGH | MEDIUM | LOW — how hard an interviewer is likely to probe it.
  risk         String          @default("MEDIUM")
  claims       ResumeClaim[]

  @@index([resumeId, order])
}

/// An interviewable claim, grounded in a quote from the resume.
model ResumeClaim {
  id         String       @id @default(cuid())
  resumeId   String
  resume     CareerResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  chunkId    String?
  chunk      ResumeChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  claim      String
  /// Verbatim (or near-verbatim) resume text supporting the claim.
  evidence   String
  skills     String[]     @default([])
  /// HIGH | MEDIUM | LOW — how clearly the resume supports it.
  confidence String
  risk       String
  /// Levels an interviewer can drill (1 definition … 7 architecture).
  depth      Int          @default(3)

  @@index([resumeId])
}

enum PrepPlanStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

enum PrepCategory {
  GENERAL
  SKILL
  PROJECT
  CLAIM
  ACHIEVEMENT
  CONCEPTUAL
  SCENARIO
}

enum PrepPriority {
  INTENSE
  IMPORTANT
  GOOD
  MAY_BE_ASKED
}

/// A personalised Top-100 question plan: resume + (JD or target role).
model PrepPlan {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String
  resume      CareerResume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId       String?
  job         JobTarget?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Key from TARGET_ROLES when no JD was chosen.
  targetRole  String?
  /// Experience band the questions are pitched at: STUDENT | JUNIOR | MID | SENIOR.
  band        String?
  title       String
  status      PrepPlanStatus @default(QUEUED)
  /// Per-step progress shown while generating.
  progress    Json
  /// Questions per category, decided by code from the resume/JD.
  allocation  Json
  /// Validator stats: generated / accepted / rejected by reason.
  validation  Json?
  error       String?
  model       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  questions   PrepQuestion[]
  packs       PrepPack[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PrepQuestion {
  id            String        @id @default(cuid())
  planId        String
  plan          PrepPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Position in the plan (difficulty ladder order). 0 = a candidate not yet published.
  rank          Int           @default(0)
  /// Ladder stage: 1 Basics, 2 Core, 3 Advanced (0 = plans made before stages existed).
  stage         Int           @default(0)
  category      PrepCategory
  priority      PrepPriority
  question      String
  skill         String
  /// 0–1 likelihood an interviewer asks this.
  probability   Float
  /// 1 fundamental … 5 architecture
  difficulty    Int
  /// How many levels of follow-up this can be drilled (1–7).
  followUpDepth Int
  /// Why it was generated from THIS resume.
  why           String
  /// Resume text it is grounded in (empty for role-level questions).
  evidence      String        @default("")
  sourceType    String
  sourceLabel   String
  chunkId       String?
  claimId       String?
  hint          String
  keyPoints     String[]      @default([])
  followUps     String[]      @default([])
  /// Cached translations: { hinglish: { question, hint, keyPoints[] }, hi: {...} }
  translations  Json          @default("{}")
  /// NEW | PRACTICED | CONFIDENT
  status        String        @default("NEW")
  createdAt     DateTime      @default(now())
  attempts      PrepAttempt[]

  @@index([planId, rank])
  @@index([planId, category])
}

model PrepAttempt {
  id         String       @id @default(cuid())
  questionId String
  question   PrepQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     String
  score      Int
  evaluation Json
  createdAt  DateTime     @default(now())

  @@index([questionId, createdAt])
  @@index([userId, createdAt])
}

/// A downloadable interview pack (PDF), generated in the background.
model PrepPack {
  id          String         @id @default(cuid())
  planId      String
  plan        PrepPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// QUESTIONS | HINTS | GUIDE
  variant     String
  /// en | hinglish | hi
  language    String
  status      PrepPlanStatus @default(QUEUED)
  storageKey  String?
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  @@index([planId, createdAt])
  @@index([status, createdAt])
}

/// A study guide for one skill in one language (what it is, real-world use, implementation, perks,
/// drawbacks…). Generic, so it is generated once and shared; personal context is added per request.
/// A skill broken into domains → concepts (the knowledge map). Curated for big tracks (System Design),
/// generated once per skill otherwise, and shared by every learner.
model SkillMap {
  id        String   @id @default(cuid())
  /// Canonical skill key ("nodejs" for Node.js / NodeJS).
  key       String   @unique
  name      String
  /// CURATED | AI
  source    String
  content   Json
  model     String?
  createdAt DateTime @default(now())
}

/// One concept chapter (one-liner, why, mental model, diagrams, code, trade-offs, levels, cheat sheet…).
/// Generated on first open and cached for everyone; validated against a fixed schema.
model SkillConcept {
  id         String   @id @default(cuid())
  skillKey   String
  conceptKey String
  locale     String
  title      String
  content    Json
  model      String?
  createdAt  DateTime @default(now())

  @@unique([skillKey, conceptKey, locale])
}

/// A learner's progress on one concept. MASTERED is only earned by explaining it well, not by reading.
model ConceptProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillKey        String
  conceptKey      String
  /// LEARNING | UNDERSTOOD | MASTERED
  status          String    @default("LEARNING")
  explainScore    Int?
  explainAttempts Int       @default(0)
  lastExplainedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, skillKey, conceptKey])
  @@index([userId, skillKey])
}

model SkillGuide {
  id        String   @id @default(cuid())
  /// Canonical skill key ("nodejs" for Node.js / NodeJS / node js).
  key       String
  name      String
  /// en | hinglish | hi
  locale    String
  content   Json
  model     String?
  createdAt DateTime @default(now())

  @@unique([key, locale])
}

// ───────────────────────── Personalization engine ─────────────────────────

/// A student's estimated state on one concept, from many signals (never one quiz).
/// conceptId is namespaced: "topic:<slug>" (curriculum) or "skill:<canonical key>" (resume/job/interview skills).
model StudentSkillState {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId       String
  label           String
  /// 0–1 estimate of how well the student knows it.
  mastery         Float
  /// 0–1: how much real evidence the estimate rests on.
  confidence      Float
  /// 0–1 chance it has been forgotten by now.
  forgettingRisk  Float
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  averageTimeSec  Float?
  lastSeen        DateTime?
  nextReview      DateTime?
  /// Evidence counts per source: { quiz, review, build, prep, interview, explain, resumePrior }.
  signals         Json
  modelVersion    String
  updatedAt       DateTime  @updatedAt

  @@id([userId, conceptId])
  @@index([userId, mastery])
  @@index([conceptId])
}

/// One "next best action" shown to a student, with the features and model that scored it.
model Recommendation {
  id              String                   @id @default(cuid())
  /// The target-role profile this recommendation serves (null: before role profiles existed).
  targetProfileId String?
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LEARN_TOPIC | REVISE_TOPIC | REVISIT_PREREQUISITE | PRACTICE_SKILL | PRACTICE_QUESTION | FINISH_BUILD | LEARN_CONCEPT
  action          String
  /// TOPIC | SKILL | PREP_QUESTION | BUILD_TASK | CONCEPT
  itemType        String
  itemId          String
  title           String
  href            String
  score           Float
  rank            Int
  /// easy | medium | hard
  difficulty      String?
  /// HIGH | MEDIUM | LOW
  priority        String
  /// Machine-readable reasons (low_mastery, high_role_relevance, interview_weakness…).
  reasons         String[]
  /// Feature values the score came from — for audit and as training rows.
  features        Json
  modelName       String
  modelVersion    String
  /// ACTIVE | DONE | SUPERSEDED | EXPIRED | DISMISSED
  status          String                   @default("ACTIVE")
  /// Training label, resolved from later activity: SUCCESS (1) | FAILURE (0) | null (no label, e.g. never acted on).
  outcome         String?
  /// What actually happened: STARTED → SUCCESS | NO_IMPROVEMENT | ABANDONED, or NOT_ACTED_ON (shown, never started).
  outcomeDetail   String?
  /// Change in the concept's mastery from when it was recommended to when it was resolved.
  improvement     Float?
  /// Every outcome signal, not just the label: accepted, started, completed, masteryDelta, quizDelta,
  /// buildDelta, interviewDelta (filled in when the next interview happens) and retention.
  outcomeSignals  Json?
  startedAt       DateTime?
  /// Rollout arm the student was in when this was ranked: ml | baseline.
  arm             String?
  shownAt         DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  expiresAt       DateTime
  resolvedAt      DateTime?
  feedback        RecommendationFeedback[]
  predictions     MLPrediction[]

  @@index([userId, status, rank])
  @@index([itemType, itemId])
  @@index([status, expiresAt])
  @@index([arm, outcomeDetail])
  @@index([userId, targetProfileId, status])
}

model RecommendationFeedback {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHOWN | ACCEPTED | IGNORED | STARTED | COMPLETED | SKIPPED | SUCCESSFUL | UNSUCCESSFUL
  action           String
  /// USER (the student did it) or SYSTEM (resolved from their activity).
  source           String         @default("USER")
  createdAt        DateTime       @default(now())

  @@index([recommendationId, action])
  @@index([userId, createdAt])
}

/// Every score or estimate a model produced, with the model that produced it.
model MLPrediction {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  modelName        String
  modelVersion     String
  /// RECOMMENDATION_SCORE | OPTIMAL_DIFFICULTY
  target           String
  prediction       Float
  confidence       Float?
  meta             Json?
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([modelName, modelVersion])
  @@index([userId, target, createdAt])
}

/// One training attempt of the recommendation model, including attempts refused for lack of data.
model MLTrainingRun {
  id           String    @id @default(cuid())
  modelName    String
  modelVersion String?
  /// TRAINED | INSUFFICIENT_DATA | FAILED
  status       String
  datasetSize  Int
  positives    Int       @default(0)
  negatives    Int       @default(0)
  features     String[]  @default([])
  /// ROC-AUC, PR-AUC, precision, recall, calibration… (null when not trained).
  metrics      Json?
  library      String?
  notes        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([modelName, startedAt])
}

// ───────────────────────── Project experience intelligence ─────────────────────────

/// One project (or job) from a resume, as an interview-preparation module. Built from the resume's
/// PROJECT / EXPERIENCE chunks; facts are editable without touching the resume.
model ProjectExperience {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String
  resume      CareerResume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  /// Stable key within the resume (normalized project name).
  key         String
  name        String
  /// PROJECT | EXPERIENCE | BOTH — where it appears on the resume.
  source      String
  company     String?
  role        String?
  /// Level A evidence copied from the resume: chunk ids, text, technologies, problem, features, contribution, claims.
  evidence    Json
  /// Editable facts: { [field]: { value, source: RESUME | USER | null } }. Unknown = null, never guessed.
  facts       Json
  /// Generated module (explanations, decisions, questions…), validated; null until first opened.
  content     Json?
  /// Hash of the facts the content was generated from — edited facts make it stale.
  contentHash String?
  model       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tests       ProjectTest[]
  answers     ProjectAnswer[]

  @@unique([resumeId, key])
  @@index([userId])
}

/// A project knowledge test: QUICK (10), DEEP (20), DRILL (adaptive), SENIOR (L4–L5), DEFENSE (resume claims).
model ProjectTest {
  id          String            @id @default(cuid())
  projectId   String
  project     ProjectExperience @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String
  /// IN_PROGRESS | COMPLETED
  status      String            @default("IN_PROGRESS")
  /// Planned / asked questions and the adaptive state (current level, follow-ups so far).
  state       Json
  /// Scores per dimension with evidence, and skill gaps (set when completed).
  result      Json?
  /// A later test on the same project after one was completed: the re-interview.
  isRetest    Boolean           @default(false)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  answers     ProjectAnswer[]

  @@index([projectId, startedAt])
  @@index([userId, startedAt])
}

/// One answered project question (scores feed skill state and personalization).
model ProjectAnswer {
  id          String            @id @default(cuid())
  testId      String
  test        ProjectTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  projectId   String
  project     ProjectExperience @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionKey String
  question    String
  level       Int
  /// PROJECT | ARCHITECTURE | TECHNOLOGY | DATABASE | API | SECURITY | PERFORMANCE | DEBUGGING | TRADEOFFS | SCALABILITY
  dimension   String
  skill       String
  isFollowUp  Boolean           @default(false)
  answer      String
  /// 0–100
  score       Int
  evaluation  Json
  createdAt   DateTime          @default(now())

  @@index([projectId, createdAt])
  @@index([userId, skill])
  @@index([testId, createdAt])
}

// ───────────────────────── Career taxonomy ─────────────────────────

/// A career the platform prepares people for. Seeded from the built-in catalogue; extensible in the database.
model CareerRole {
  key             String           @id
  family          String
  name            String
  description     String
  /// Words that identify the role in a target, resume headline or job title.
  aliases         String[]         @default([])
  specializations String[]         @default([])
  /// Whether coding tasks may appear at all for this role.
  code            Boolean          @default(false)
  /// Interview areas with weights: [{ key, label, description, weight }].
  areas           Json
  /// Evaluation rubric (common + role dimensions): [{ key, label, description }].
  rubric          Json
  assessments     String[]         @default([])
  domain          String?
  version         Int
  active          Boolean          @default(true)
  /// Reviewed by a practitioner of the profession (false for the built-in catalogue).
  reviewed        Boolean          @default(false)
  updatedAt       DateTime         @updatedAt
  competencies    RoleCompetency[]

  @@index([family, active])
}

/// A skill or competency, shared across roles. key = canonical skill key (same as StudentSkillState "skill:<key>").
model Competency {
  key           String                   @id
  name          String
  /// TOOL | TECHNICAL | ANALYTICAL | PRODUCT | BUSINESS | DOMAIN | COMMUNICATION | PEOPLE | DESIGN
  kind          String
  description   String
  assessments   String[]                 @default([])
  /// Learning content and tasks may contain code (programming, SQL, scripts).
  code          Boolean                  @default(false)
  aliases       String[]                 @default([])
  version       Int
  active        Boolean                  @default(true)
  roles         RoleCompetency[]
  prerequisites CompetencyPrerequisite[] @relation("dependent")
  dependents    CompetencyPrerequisite[] @relation("prerequisite")
}

model RoleCompetency {
  roleKey       String
  role          CareerRole @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  competencyKey String
  competency    Competency @relation(fields: [competencyKey], references: [key], onDelete: Cascade)
  /// REQUIRED | PREFERRED | OPTIONAL
  importance    String
  weight        Float

  @@id([roleKey, competencyKey])
  @@index([competencyKey])
}

model CompetencyPrerequisite {
  competencyKey   String
  competency      Competency @relation("dependent", fields: [competencyKey], references: [key], onDelete: Cascade)
  prerequisiteKey String
  prerequisite    Competency @relation("prerequisite", fields: [prerequisiteKey], references: [key], onDelete: Cascade)

  @@id([competencyKey, prerequisiteKey])
}

/// One career a user is preparing for. Readiness, plans and recommendations are scoped to it;
/// competency evidence (StudentSkillState) is shared, because a skill shown once is shown.
model TargetRoleProfile {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CareerRole.key (validated by the taxonomy service; roles can be added without migrations).
  roleKey         String
  /// STUDENT | JUNIOR | MID | SENIOR
  level           String
  jobId           String?
  job             JobTarget?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  timeline        DateTime?
  primary         Boolean            @default(false)
  /// ACTIVE | ARCHIVED
  status          String             @default("ACTIVE")
  taxonomyVersion Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  interviews      InterviewSession[]

  @@unique([userId, roleKey])
  @@index([userId, status])
}
