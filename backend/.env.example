NODE_ENV=development
PORT=4000
# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Upstash/any Redis over TCP (BullMQ needs TCP, not the REST API). Set eviction policy to noeviction.
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Google Identity Services (optional). Add your frontend origins in Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# process = local dev only (not a security boundary). docker = production isolation.
SANDBOX_DRIVER=process
SANDBOX_TIMEOUT_MS=4000
SANDBOX_MEMORY_MB=128
SANDBOX_CONCURRENCY=4
# AI tutor (optional): none | gemini | openrouter | ollama | huggingface
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Tried in order when the primary Gemini model is overloaded (503) or retired (404).
# Top-100 plan generations per user per rolling 24h (each plan costs ~20–25 AI calls).
PREP_DAILY_PLAN_LIMIT=3
AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Set to true behind HTTPS in production (defaults to true when NODE_ENV=production).
COOKIE_SECURE=
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeThisPassword1
