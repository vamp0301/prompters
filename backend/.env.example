NODE_ENV=development
PORT=4000
# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Upstash/any Redis over TCP (BullMQ needs TCP, not the REST API). Set eviction policy to noeviction.
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Google Identity Services (optional). Add your frontend origins in Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# process = local dev only (not a security boundary). docker = production isolation.
# process = development only · docker = production sandbox · disabled = no user code runs (safe until Docker is deployed)
SANDBOX_DRIVER=process
SANDBOX_TIMEOUT_MS=4000
SANDBOX_MEMORY_MB=128
SANDBOX_CONCURRENCY=4
# AI tutor (optional): none | gemini | openrouter | ollama | huggingface
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Tried in order when the primary Gemini model is overloaded (503) or retired (404).
# Top-100 plan generations per user per rolling 24h (each plan costs ~20–25 AI calls).
PREP_DAILY_PLAN_LIMIT=3
AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Set to true behind HTTPS in production (defaults to true when NODE_ENV=production).
COOKIE_SECURE=
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeThisPassword1

# ── Manisha's cloud voice (optional; the browser's own speech is the fallback) ──
# Speech-to-text: Deepgram. The browser streams audio with a 30-second token; the key stays here.
STT_PROVIDER=browser
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en
# Streaming connections per student per day (one per voice answer, plus reconnects).
# STT_USER_DAILY_TOKEN_LIMIT=150
# Text-to-speech: ElevenLabs (needs a voice ID: ElevenLabs → Voices → ⋯ → Copy voice ID).
TTS_PROVIDER=browser
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Characters per month (all users) / per user per day; past them the browser voice takes over.
# TTS_MONTHLY_CHAR_LIMIT=9000
# TTS_USER_DAILY_CHAR_LIMIT=3000

# ── Personalization ML service (optional) ──
# Without these the engine uses its transparent baseline ranker (and says so). The service must
# stay internal: bind it to localhost/private network and set the same random token on both sides.
# ML_SERVICE_URL=http://127.0.0.1:8100
# ML_SERVICE_TOKEN=
# ML_TIMEOUT_MS=800
# Share of students (stable per student) ranked by a trained model; the rest are the baseline comparison group.
# ML_TRAFFIC_PERCENT=5
